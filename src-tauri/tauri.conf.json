{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wrusp",
  "version": "0.4.12",
  "identifier": "wrusp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "icons/appicons/": "appicons/"
    },
    "category": "Utility",
    "shortDescription": "Cliente no oficial de WhatsApp",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
